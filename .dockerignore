# Keep the build context small, and keep secrets out of the image.
.git
.gitignore
node_modules
.next
out

# Never bake credentials into a layer.
.env
.env.*
!.env.example

# PocketBase runs as its own service — its database has no business here.
pb_data
pb_migrations
pocketbase

*.md
!README.md
.DS_Store
npm-debug.log*
