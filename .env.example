# ---------------------------------------------------------------------------
# Level One — CV & Application Generator
#
# Copy this file to .env.local and fill in the blanks.
# ENV-VARS.md explains where every one of these comes from, step by step.
#
# .env.local is ignored by git. Never commit your real keys.
# ---------------------------------------------------------------------------

# --- PocketBase: where your CV and your saved applications live -------------

# The address of your PocketBase server.
# On your own computer: http://127.0.0.1:8090
# On a server:          https://pocketbase.yourdomain.com
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# The PocketBase account you created with `./pocketbase superuser create`.
# This is NOT your real email login — it is an account that only exists inside
# PocketBase, with a password you invented. The app signs in with it on the
# server so your CV can stay completely private.
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# --- Gemini: the AI that tailors your CV ------------------------------------

# From Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which model does the writing. Just a name — change it here, no code change
# needed. gemini-2.5-flash works and is cheap, but it is a previous
# generation; newer Flash models write better. The model dropdown at
# https://aistudio.google.com is the authoritative list for your own key.
GEMINI_MODEL=gemini-2.5-flash

# --- Optional: everything below has a sensible default ----------------------

# The instruction Gemini follows when rewriting your CV. Leave this blank and
# the app uses its built-in prompt, which is printed in full in ENV-VARS.md.
# Set it to take over the writing style without touching any code.
#
# It must be one line: replace every line break with \n.
GEMINI_CV_PROMPT=

# Which Chrome or Chromium turns your CV into a PDF.
# Leave blank and the app finds one itself — it checks Playwright's browsers,
# then the usual Google Chrome, Chromium and Edge locations on Mac, Windows
# and Linux. Only set this if it cannot find yours, or you want a specific one.
#
#   Mac:     /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   Linux:   /usr/bin/google-chrome
PDF_CHROMIUM_PATH=

# --- Job searching ----------------------------------------------------------

# Which Python runs scripts/scrape_jobs.py. Leave blank and "python3" is used.
# The Docker image sets this to /usr/bin/python3 already.
#
# Job searching needs python-jobspy:
#   pip install --break-system-packages python-jobspy
PYTHON_BIN=

# --- Extra job sites: all optional, all free --------------------------------
#
# LinkedIn, Indeed, Google and Glassdoor are searched with no key at all. The
# two below are proper APIs with keys, which means they answer every time
# instead of rate limiting after a few pages. Leave them blank and the search
# still works — it just uses fewer sites, and says so in the run summary.

# Adzuna. Sign up at https://developer.adzuna.com — the page shows you an
# App ID (short) and an App Key (long). Copy one into each of these.
#
# Note: Adzuna only gives a SUMMARY of each advert, not the whole thing. Those
# jobs are kept and marked "summary only" on the card, so open the posting
# before you apply.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Reed, the biggest UK-only job board. Register at
# https://www.reed.co.uk/developers and it emails you one key. Paste it here.
REED_API_KEY=

# Facts about your availability that no advert supplies and no CV field holds.
# Leave blank for the built-in default: available immediately, Edinburgh, open
# to UK remote. Set it to a single space to omit the block entirely.
#
# ONLY put things here that are true and that only you can assert. Skills belong
# in cv_profile, where the CV can back them up.
CV_CANDIDATE_CONTEXT=

# Names that must NEVER appear on a generated CV — client companies you are
# under contract not to name. Comma separated.
#
# The AI is already told not to print client names, but an instruction is a
# request. This is enforced in code afterwards, so it holds no matter what the
# model does. Anything listed here is stripped from every generated field and
# replaced with "a client".
#
#   CV_REDACT_NAMES=Grove Group, Trader Brothers, Cekra
#
# Safest of all is not typing the name into cv_projects in the first place.
CV_REDACT_NAMES=
