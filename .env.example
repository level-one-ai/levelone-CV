# ---------------------------------------------------------------------------
# Level One — CV & Application Generator
#
# Copy this file to .env.local and fill in the blanks.
# SETUP.md explains where every one of these values comes from, step by step.
#
# .env.local is ignored by git. Never commit your real keys.
# ---------------------------------------------------------------------------

# --- PocketBase: where your CV and your saved applications live -------------

# The address of your PocketBase server.
# Running it on your own computer: http://127.0.0.1:8090
# Running it on a server:          https://pocketbase.yourdomain.com
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# The superuser login you create the first time you open the PocketBase admin
# page. The app signs in with this on the server so your CV collections can
# stay completely private.
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# --- Gemini: the AI that writes the application -----------------------------

# From Google AI Studio. SETUP.md step 2.
GEMINI_API_KEY=

# Which model writes your applications. Just a name — change it here, no code
# change needed. gemini-2.5-flash works and is cheap, but it is a previous
# generation; newer Flash models write better. The model dropdown at
# https://aistudio.google.com is the authoritative list for your own key.
# A name your key cannot use produces a clear error naming the problem.
GEMINI_MODEL=gemini-2.5-flash

# --- Your Word template ------------------------------------------------------

# Where your master CV lives, relative to this project folder.
# You almost never need to change this.
CV_TEMPLATE_PATH=templates/master-cv.docx
